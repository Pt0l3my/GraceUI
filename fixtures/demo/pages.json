    {
      "id": "demo.keepers",
      "category": "lanterns",
      "name": "Keepers",
      "description": "Who keeps the lantern, their ward words, and the oil they burn.",
      "help": {
        "purpose": "Look after the lantern's keepers and choose its oil.",
        "steps": [
          "Read the roster: each keeper's post, and whether their ward word is set.",
          "Set a keeper's ward word on their row, or dismiss them; dismissing asks first.",
          "Hire a keeper with the form, or bring several from a roster file in the browser view on this PC.",
          "Choose the oil from what the store holds."
        ]
      },
      "related": [
        "demo.behaviour",
        "demo.overview"
      ],
      "increment": "0.2",
      "sections": [
        {
          "id": "roster",
          "title": "Roster",
          "blocks": [
            {
              "kind": "component",
              "component": "table",
              "topic": "lantern.keepers",
              "props": {
                "empty": "No keeper yet: hire one below."
              },
              "row_actions": [
                {
                  "id": "dismiss",
                  "label": "Dismiss",
                  "command": "keepers.dismiss",
                  "key": "id",
                  "tone": "destructive",
                  "confirm": "The keeper leaves the roster, with their ward word."
                }
              ],
              "row_secret": {
                "column": "ward",
                "command": "keepers.ward",
                "key": "id"
              }
            }
          ],
          "actions": [
            {
              "id": "dismiss_all",
              "label": "Dismiss all",
              "command": "keepers.dismiss_all",
              "tone": "destructive",
              "confirm": "Every keeper leaves the roster, with their ward words."
            }
          ]
        },
        {
          "id": "hire",
          "title": "Hire a keeper",
          "blocks": [
            {
              "kind": "form",
              "command": "keepers.hire",
              "fields": [
                {
                  "id": "name",
                  "label": "Name",
                  "max": 32
                },
                {
                  "id": "post",
                  "label": "Post",
                  "max": 64
                }
              ],
              "submit": "Hire"
            }
          ]
        },
        {
          "id": "oil",
          "title": "Oil",
          "blocks": [
            {
              "kind": "settings",
              "keys": [
                "lantern.oil_kind"
              ]
            }
          ],
          "chip": "store",
          "status": {
            "topic": "lantern.oils",
            "field": "stock"
          },
          "actions": [
            {
              "id": "order",
              "label": "Order oil",
              "command": "oil.order",
              "tone": "secondary"
            }
          ]
        },
        {
          "id": "roster_file",
          "title": "From a roster file",
          "description": "A harbour roster lists several keepers at once; each keeper it names joins the roster.",
          "blocks": [
            {
              "kind": "upload",
              "command": "keepers.import",
              "submit": "Add a roster file",
              "accept": ".toml, .txt"
            }
          ]
        }
      ]
