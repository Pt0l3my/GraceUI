    {
      "id": "demo.log",
      "category": "records",
      "name": "Log",
      "description": "What the lantern did, as it happens, and the keeper's journal.",
      "help": {
        "purpose": "Follow the lantern's log as it is written, and read the keeper's journal.",
        "steps": [
          "Watch new lines arrive at the top of the log.",
          "Read older entries in the journal below.",
          "Clear the log from the header; the journal stays."
        ]
      },
