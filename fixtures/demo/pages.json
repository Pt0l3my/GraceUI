      "id": "demo.overview",
      "category": "lanterns",
      "name": "Overview",
      "description": "The lantern at a glance: its flame, its oil and its last trim.",
      "help": {
        "purpose": "See how the north lantern is burning right now.",
        "steps": [
          "Read the tiles: flame, oil and the time since the last trim.",
          "Trim the wick from the header when the flame gutters.",
          "Adjust its brightness here, or everything else on Behaviour."
        ]
      },
      "related": [
        "demo.behaviour",
        "demo.log"
      ],
      "increment": "0.2",
