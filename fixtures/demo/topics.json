  "lantern.guide/lighting": {
    "title": "Lighting the lamp",
    "blocks": [
      {
        "paragraph": [
          {
            "text": "A lamp lit well burns all night with one trim. Read "
          },
          {
            "text": "Oil",
            "doc": "oil"
          },
          {
            "text": " first if the lamp is new to you."
          }
        ]
      },
      {
        "heading": "Before dusk"
      },
      {
        "list": [
          "Clean the glass inside and out.",
          "Fill the oil to the line, never above it.",
          "Check the wick is dry."
        ],
        "ordered": true
      },
      {
        "heading": "The match"
      },
      {
        "paragraph": [
          {
            "text": "Strike the match away from the glass, and light the wick at its "
          },
          {
            "text": "edge",
            "strong": true
          },
          {
            "text": ", not its middle."
          }
        ]
      },
      {
        "note": [
          {
            "text": "Never leave a lit lamp alone in its first quarter hour."
          }
        ]
      },
      {
        "heading": "Trimming",
        "level": 3
      },
      {
        "paragraph": [
          {
            "text": "Trim to a flat, even wick; a peaked wick smokes. In wind, see "
          },
          {
            "text": "Keeping a lamp in a storm",
            "doc": "storms",
            "heading": "Wind"
          },
          {
            "text": "."
          }
        ]
      }
    ]
  },
