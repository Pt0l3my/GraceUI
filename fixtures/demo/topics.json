              "smoke": "Much"
            }
          ]
        }
      },
      {
        "heading": "Storing it"
      },
      {
        "paragraph": "Keep it cool and dark, in the store room, sealed."
      },
      {
        "code": "store room   rapeseed  12 jars\nstore room   olive      4 jars"
      }
    ]
  },
  "lantern.guide/storms": {
    "title": "Keeping a lamp in a storm",
    "blocks": [
      {
        "heading": "Wind"
      },
      {
        "paragraph": "Lower the wick a turn before the wind rises; a tall flame in a gust blackens the glass."
      },
      {
        "heading": "Rain"
      },
      {
        "paragraph": [
          {
            "text": "Rain on hot glass can crack it. Close the hood, and see "
          },
          {
            "text": "Lighting the lamp",
            "doc": "lighting",
            "heading": "Trimming"
          },
          {
            "text": " for the trim after."
          }
        ]
      },
      {
        "heading": "When to shutter"
      },
      {
        "paragraph": [
          {
            "text": "Shutter only on the harbour master's word. A guide not yet written, "
          },
          {
            "text": "Signals",
            "doc": "signals"
          },
          {
            "text": ", will say more."
          }
        ]
      }
    ]
  },
