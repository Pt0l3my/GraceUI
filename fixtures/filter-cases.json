{
  "about": "A table's filter bar (G43, D250): the same rows and choices give the same rows, in the same order, in both views. Run by web/tests/unit/filter.test.ts and grace-view's filter tests. Invented keepers.",
  "rows": [
    {"id": "a", "name": "Orla Venn", "post": "North light", "met_s": 120},
    {"id": "b", "name": "tamsin Reed", "post": "Harbour wall", "met_s": 45},
    {"id": "c", "name": "Ada Marsh", "post": "North light"},
    {"id": "d", "name": "Bram Holt", "post": "Store room", "met_s": 120},
    {"id": "e", "name": "Éli Sand", "post": "Harbour wall", "met_s": 9.5},
    "not a row",
    {"id": "f", "name": "", "post": "", "met_s": "late"}
  ],
  "choices": [
    {"column": "post", "expect": ["North light", "Harbour wall", "Store room"]},
    {"column": "met_s", "expect": ["120", "45", "9.5", "late"]},
    {"column": "nowhere", "expect": []}
  ],
  "cases": [
    {"name": "nothing chosen: every row, in the space's order",
     "spec": {"filters": [{"column": "post", "label": "Post"}]},
     "state": {"chosen": [null], "sort": 0, "reversed": false, "search": ""},
     "expect": [0, 1, 2, 3, 4, 6], "narrowed": false},
    {"name": "a filter keeps the rows with its value",
     "spec": {"filters": [{"column": "post", "label": "Post"}]},
     "state": {"chosen": ["North light"], "sort": 0, "reversed": false, "search": ""},
     "expect": [0, 2], "narrowed": true},
    {"name": "a value no row has keeps none",
     "spec": {"filters": [{"column": "post", "label": "Post"}]},
     "state": {"chosen": ["Nowhere"], "sort": 0, "reversed": false, "search": ""},
     "expect": [], "narrowed": true},
    {"name": "the search ignores ASCII case, in its named columns only",
     "spec": {"search": {"columns": ["name"], "label": "Find a name"}},
     "state": {"chosen": [], "sort": 0, "reversed": false, "search": "  RE "},
     "expect": [1], "narrowed": true},
    {"name": "a search on a column it does not name finds nothing",
     "spec": {"search": {"columns": ["name"], "label": "Find a name"}},
     "state": {"chosen": [], "sort": 0, "reversed": false, "search": "harbour"},
     "expect": [], "narrowed": true},
    {"name": "a blank search keeps every row",
     "spec": {"search": {"columns": ["name"], "label": "Find a name"}},
     "state": {"chosen": [], "sort": 0, "reversed": false, "search": "   "},
     "expect": [0, 1, 2, 3, 4, 6], "narrowed": false},
    {"name": "by name: folded ASCII, then by code point; an empty name last",
     "spec": {"sort": [{"key": "name", "label": "Name"}]},
     "state": {"chosen": [], "sort": 0, "reversed": false, "search": ""},
     "expect": [2, 3, 0, 1, 4, 6], "narrowed": false},
    {"name": "by name reversed: the empty name still last",
     "spec": {"sort": [{"key": "name", "label": "Name"}]},
     "state": {"chosen": [], "sort": 0, "reversed": true, "search": ""},
     "expect": [4, 1, 0, 3, 2, 6], "narrowed": false},
    {"name": "a hidden key ascending: numbers as numbers, ties in the space's order, no value last",
     "spec": {"sort": [{"key": "name", "label": "Name"}, {"key": "met_s", "label": "Met", "direction": "ascending"}]},
     "state": {"chosen": [], "sort": 1, "reversed": false, "search": ""},
     "expect": [4, 1, 0, 3, 6, 2], "narrowed": false},
    {"name": "a hidden key descending by default: no value still last, ties still in the space's order",
     "spec": {"sort": [{"key": "met_s", "label": "Last met", "direction": "descending"}]},
     "state": {"chosen": [], "sort": 0, "reversed": false, "search": ""},
     "expect": [6, 0, 3, 1, 4, 2], "narrowed": false},
    {"name": "a descending option reversed is ascending",
     "spec": {"sort": [{"key": "met_s", "label": "Last met", "direction": "descending"}]},
     "state": {"chosen": [], "sort": 0, "reversed": true, "search": ""},
     "expect": [4, 1, 0, 3, 6, 2], "narrowed": false},
    {"name": "a filter, then the sort",
     "spec": {"filters": [{"column": "post", "label": "Post"}], "sort": [{"key": "met_s", "label": "Met"}]},
     "state": {"chosen": ["Harbour wall"], "sort": 0, "reversed": false, "search": ""},
     "expect": [4, 1], "narrowed": true},
    {"name": "a sort option out of range sorts nothing; a choice past the filters counts for nothing",
     "spec": {"filters": [{"column": "post", "label": "Post"}], "sort": [{"key": "name", "label": "Name"}]},
     "state": {"chosen": [null, "North light"], "sort": 3, "reversed": false, "search": ""},
     "expect": [0, 1, 2, 3, 4, 6], "narrowed": false}
  ]
}
