{
  "name": "graceui-web",
  "version": "0.2.0",
  "description": "GraceUI's browser view: the web shell over every space's page data (DESIGN §2.5, §4.2, G3).",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"tests/unit/*.test.ts\"",
    "test:dom": "node --test --test-concurrency=1 \"tests/dom/*.test.ts\"",
    "screenshots": "node tests/screenshots.ts",
    "check:space": "node tools/check-space.ts"
  },
  "dependencies": {
    "@preact/signals": "2.11.4",
    "preact": "11.2.0"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vite": "7.3.8"
  }
}
